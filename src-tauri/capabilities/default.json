{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "pokeclaw:allow-chat",
    "pokeclaw:allow-start-session",
    "pokeclaw:allow-stop-session",
    "pokeclaw:allow-send-message",
    "pokeclaw:allow-get-session-status",
    "pokeclaw:allow-list-models",
    "pokeclaw:allow-download-model",
    "pokeclaw:allow-get-screen-info",
    "pokeclaw:allow-find-node-info",
    "pokeclaw:allow-get-device-info",
    "pokeclaw:allow-check-permissions",
    "dialog:default"
  ]
}
