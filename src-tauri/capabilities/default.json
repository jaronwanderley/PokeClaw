{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "pokeclaw:allow-chat",
    "pokeclaw:allow-start-session",
    "pokeclaw:allow-stop-session",
    "pokeclaw:allow-send-message",
    "pokeclaw:allow-get-session-status"
  ]
}
